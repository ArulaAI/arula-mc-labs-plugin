#!/usr/bin/env bash
CACHE_FILE="${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/.python_path"
SENTINEL="WORKBENCH_PY_OK"

# --- cache validation ---------------------------------------------------
use_cache=false
if [ -f "$CACHE_FILE" ] && [ -s "$CACHE_FILE" ]; then
  PY=$(cat "$CACHE_FILE")
  # The cached path must (a) exist, (b) be executable, and (c) be a real
  # Python 3.11+ interpreter.  Exit-code alone is not trusted — a stale
  # /bin/true would pass that.  Require the exact sentinel on stdout.
  if [ -x "$PY" ] 2>/dev/null; then
    CHECK=$("$PY" -c "import sys;print('$SENTINEL') if sys.version_info>=(3,11) else sys.exit(1)" 2>/dev/null) || true
    if [ "$CHECK" = "$SENTINEL" ]; then
      use_cache=true
    fi
  fi
  if [ "$use_cache" = false ]; then
    rm -f "$CACHE_FILE" 2>/dev/null || true
  fi
fi

# --- resolve if cache was invalid or missing -----------------------------
if [ "$use_cache" = false ]; then
  if   PY=$(py -3 -c "import sys;sys.version_info>=(3,11)or sys.exit(1);print(sys.executable)" 2>/dev/null); then :
  elif PY=$(python3 -c "import sys;sys.version_info>=(3,11)or sys.exit(1);print(sys.executable)" 2>/dev/null); then :
  elif PY=$(python -c "import sys;sys.version_info>=(3,11)or sys.exit(1);print(sys.executable)" 2>/dev/null); then :
  else echo "Python 3.11+ not found. Install from https://python.org" >&2; exit 1
  fi
  printf '%s' "$PY" > "$CACHE_FILE" 2>/dev/null || true
fi

exec "$PY" "$@"
