{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/resolve-python\" && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journey_record.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journey_record.py\" pre-tool",
            "timeout": 5
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/quality_gates.py\" pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journey_record.py\" post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journey_record.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
